+void test_additional_gpu_lend() {
+    using namespace strata::core;
+    using namespace strata::kernels::cpu;
+    TempDirectory dir;
+    std::string err;
+    require(expert_layout_load(dir.path.string(), 1, 5, err), err);
+    create_pack(dir.path, 5 * (uint64_t) BLOB, {{0, 'a'}, {BLOB, 'b'}, {2 * BLOB, 'c'}, {3 * BLOB, 'd'}, {4 * BLOB, 'e'}});
+    FileExpertSource src;
+    require(src.open(dir.path.string(), 1, 5, err), err);
+    std::vector<std::vector<uint8_t>> truth(5, std::vector<uint8_t>((size_t) BLOB));
+    for (int e = 0; e < 5; ++e) require(src.copy_blob(0, e, truth[e].data()), "read fixture");
+    ExpertCache cache;
+    require(cache.open(2, 1, 5, BLOB, err), err);
+    for (int e : {0, 1}) {
+        int slot = cache.admit(0, e);
+        require(slot >= 0 && cache.fill_slot_blocking(slot, truth[e].data(), err), err);
+    }
+    // Expert 2 belongs to a helper. Primary slot 1 is borrowed during prefill;
+    // it must be available in RAM without duplicating the helper's weights.
+    require(src.pin_cache_complement(cache, err, false, {{0, 2}}, 1, 0), err);
+    require(src.resident_lent_slots() == 1, "helper disabled the primary lend copy");
+    for (int e = 0; e < 5; ++e) {
+        require(src.has_resident(0, e) == (e == 1 || e >= 3), "wrong complement ownership");
+        std::vector<uint8_t> actual((size_t) BLOB);
+        require(src.copy_blob(0, e, actual.data()) && actual == truth[e], "lend or fallback bytes changed");
+    }
+    require(cache.verify_slot(1, src.blob(0, 1), err), err);
+}
